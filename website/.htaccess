<IfModule mod_rewrite.c>
    RewriteEngine On
    # 3.0 ist seit 30.08.2026 die Root. Der Parallelbetrieb /v30/ ist weg;
    # Lesezeichen und Homescreen-Icons zeigen aber noch dorthin. Bewusst 302
    # (nicht 301): ein 301 bliebe auf dem Gerät dauerhaft gecacht.
    RewriteRule ^v30/?$ / [R=302,L]
    RewriteRule ^v30/(.*)$ /$1 [R=302,L]
    RewriteRule ^favicon\.ico$ /icons/favicon.php [L]
    RewriteRule ^favicon-32x32\.png$ /icons/favicon.php [L]
    RewriteRule ^apple-touch-icon\.png$ /icons/apple-touch-icon.php [L]
    RewriteRule ^apple-touch-icon-precomposed\.png$ /icons/apple-touch-icon.php [L]
</IfModule>

<Files "config.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    # Veränderliche Dateien: immer revalidieren, damit Planänderungen sofort ankommen
    <FilesMatch "^(index\.html|data\.js|sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Icons ändern sich praktisch nie
    <FilesMatch "\.(png|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
