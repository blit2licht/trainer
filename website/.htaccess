<IfModule mod_rewrite.c>
    RewriteEngine On
    # 3.0 ist seit 30.08.2026 die Root. Der Parallelbetrieb /v30/ ist weg;
    # Lesezeichen und Homescreen-Icons zeigen aber noch dorthin. Bewusst 302
    # (nicht 301): ein 301 bliebe auf dem Gerät dauerhaft gecacht.
    RewriteRule ^v30/?$ / [R=302,L]
    RewriteRule ^v30/(.*)$ /$1 [R=302,L]
    # Die Root-Icons lagen frueher hinter icons/favicon.php und
    # icons/apple-touch-icon.php. Diese Skripte stammen von der Vorgaengerseite,
    # sind nicht im Repo und liefern deren altes Motiv. Seit 30.08.2026 liegen
    # favicon.ico, apple-touch-icon.png und -precomposed.png als echte Dateien
    # in website/ und werden direkt ausgeliefert -- keine Umschreibung mehr.
    RewriteRule ^favicon-32x32\.png$ /icons/favicon-32.png [L]
</IfModule>

<Files "config.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    # Veränderliche Dateien: immer revalidieren, damit Planänderungen sofort ankommen
    <FilesMatch "^(index\.html|data\.js|sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Icons ändern sich praktisch nie
    <FilesMatch "\.(png|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
